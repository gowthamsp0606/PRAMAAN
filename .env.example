# ==============================================================================
# PRAMAAN / APAAR Sentinel — Environment Configuration Template
# AICTE Hackathon SIH26263
# Note: Never commit production credentials, secrets, or real tokens to version control.
# ==============================================================================

# Runtime environment ('development' for local prototype testing, 'production' for live deployment)
ENVIRONMENT=development

# Explicit production safety latch (must be 'true' in addition to non-default SECRET_KEY and AUTH_REQUIRED)
ENABLE_PRODUCTION_MODE=false

# Database Connection URL
# Prototype default: SQLite database file (local prototype)
DATABASE_URL=sqlite:///./apaar_sentinel.db
# Production target example:
# DATABASE_URL=postgresql+psycopg2://sentinel_user:change_me_secure_db_pass@db.internal:5432/apaar_sentinel

# Master Cryptographic Secret Key
# Used for backend Ed25519 root signing key derivation and token integrity.
# In production, this must be a high-entropy secret of at least 32 characters.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Permitted CORS Origins (comma-separated list; do NOT use '*' in production)
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Authentication Enforcement
# Set to 'false' ONLY during local standalone prototype demonstrations.
# Set to 'true' in production and automated security evaluation.
AUTH_REQUIRED=false

# API Token Principals Registry (JSON object keyed by lowercase SHA-256 hex hashes of bearer tokens)
# Supported roles:
#   - 'administrator' (full system management, institutional onboard)
#   - 'institution_officer' (scoped strictly to 'institution_id')
#   - 'reviewer' (human review workflow and anomaly resolution)
#   - 'read_only_auditor' (read-only audit queries)
#   - 'external_verifier' (scoped to 'verifier_org_id' with 'purpose_scope="EMPLOYMENT_VERIFICATION"')
# Note: 'prototype_admin' is strictly prohibited when AUTH_REQUIRED=true.
#
# Example (SHA-256 of 'demo-admin-token-2026' is '2c9e7826279f...'):
API_TOKEN_PRINCIPALS_JSON={}

# Prototype Default Reviewer Name (used only when AUTH_REQUIRED=false)
DEMO_REVIEWER="Demo Officer (AICTE-RO-102)"
